# Mistral API ключ (получите на platform.mistral.ai)
# Зарегистрируйтесь на https://console.mistral.ai/ и создайте API ключ
MISTRAL_API_KEY=your_mistral_api_key_here

# Настройки локальных моделей
# Устройство для загрузки моделей: auto, cpu, cuda
LOCAL_MODEL_DEVICE=auto

# Квантизация: 4bit, 8bit, none
LOCAL_MODEL_QUANTIZATION=4bit
